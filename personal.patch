index 0000000000000000000000000000000000000000..2a0417995243126b9b6be60e0a27445a7f5fd639
--- /dev/null
+++ b/Telegram/SourceFiles/core/personal_archive_rules.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <charconv>
+#include <cstdint>
+#include <set>
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace Core {
+
+// One instance/file per signed-in account. Never keyed by mutable usernames.
+class PersonalArchiveRules final {
+public:
+    bool contains(std::uint64_t id) const { return _archived.count(id) != 0; }
+    bool observe(std::uint64_t id) {
+        return id && !_released.count(id) && _archived.insert(id).second;
+    }
+    void set(std::uint64_t id, bool enabled) {
+        if (!id) return;
+        if (enabled) { _released.erase(id); _archived.insert(id); }
+        else { _archived.erase(id); _released.insert(id); }
+    }
+    std::string serialize() const {
+        auto result = std::string("PERSONAL_ARCHIVE_1\n");
+        for (auto id : _archived) result += "A" + std::to_string(id) + "\n";
+        for (auto id : _released) result += "R" + std::to_string(id) + "\n";
+        return result;
+    }
+    bool parse(std::string_view data) {
+        constexpr auto header = std::string_view("PERSONAL_ARCHIVE_1\n");
+        if (data.size() > 16 * 1024 * 1024 || data.substr(0, header.size()) != header) return false;
+        data.remove_prefix(header.size());
+        PersonalArchiveRules parsed;
+        while (!data.empty()) {
+            auto end = data.find('\n');
+            if (end == std::string_view::npos || end < 2 || (data[0] != 'A' && data[0] != 'R')) return false;
+            std::uint64_t id = 0;
+            const auto number = data.substr(1, end - 1);
+            const auto decoded = std::from_chars(number.data(), number.data() + number.size(), id);
+            if (decoded.ec != std::errc() || decoded.ptr != number.data() + number.size() || !id
+                || parsed._archived.count(id) || parsed._released.count(id)) return false;
+            (data[0] == 'A' ? parsed._archived : parsed._released).insert(id);
+            data.remove_prefix(end + 1);
+        }
+        *this = std::move(parsed);
+        return true;
+    }
+private:
+    std::set<std::uint64_t> _archived;
+    // Prevent an old server archive update from undoing an explicit release.
+    std::set<std::uint64_t> _released;
+};
+
+} // namespace Core
diff --git a/Telegram/SourceFiles/core/personal_proxy_policy.h b/Telegram/SourceFiles/core/personal_proxy_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..e2a06c229419bfb1fd8584e769a524ca6c2d9e99
--- /dev/null
+++ b/Telegram/SourceFiles/core/personal_proxy_policy.h
@@ -0,0 +1,42 @@
+#pragma once
+#include <cstdint>
+
+namespace Core {
+
+// No persisted state. A new process constructs a fresh policy.
+class PersonalProxyPolicy final {
+public:
+	enum class State { Waiting, Trying, ProxyConnected, Direct, DirectConnected };
+	static constexpr std::int64_t kTimeout = 30000;
+	State update(std::int64_t now, bool ready, bool connected, bool direct) {
+		_fallback = _fallback || direct;
+		if (_fallback) {
+			return connected ? State::DirectConnected : State::Direct;
+		}
+		if (!ready) {
+			_disconnectedAt = -1;
+			return State::Waiting;
+		}
+		if (connected) {
+			_everConnected = true;
+			_disconnectedAt = -1;
+			return State::ProxyConnected;
+		}
+		if (_disconnectedAt < 0) {
+			_disconnectedAt = now;
+		}
+		if (now - _disconnectedAt >= kTimeout) {
+			_fallback = true;
+			return State::Direct;
+		}
+		return State::Trying;
+	}
+	bool fallback() const { return _fallback; }
+	bool everConnected() const { return _everConnected; }
+private:
+	std::int64_t _disconnectedAt = -1;
+	bool _fallback = false;
+	bool _everConnected = false;
+};
+
+} // namespace Core
