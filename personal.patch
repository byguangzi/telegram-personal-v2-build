+QString ApiWrap::personalArchivePath() const {
+    return QCoreApplication::applicationDirPath()
+        + u"/tdata/personal_archive_"_q + QString::number(_session->uniqueId()) + u".dat"_q;
+}
+
+void ApiWrap::personalArchiveWarning() {
+    if (_personalArchiveWarned) return;
+    _personalArchiveWarned = true;
+    crl::on_main(_session, [] {
+        QMessageBox::warning(nullptr, QString::fromUtf8("长期归档"),
+            QString::fromUtf8("无法读取或保存长期归档名单。请保留 tdata 并检查目录权限；不要删除名单文件。当前无法保证重启后规则有效。"));
+    });
+}
+
+void ApiWrap::loadPersonalArchive() {
+    if (_personalArchiveLoaded) return;
+    _personalArchiveLoaded = true;
+    auto file = QFile(personalArchivePath());
+    if (!file.exists()) return;
+    if (!file.open(QIODevice::ReadOnly) || file.size() > 16 * 1024 * 1024) {
+        _personalArchiveStorageOk = false;
+    } else {
+        const auto data = file.readAll();
+        _personalArchiveStorageOk = _personalArchiveRules.parse(
+            std::string_view(data.constData(), data.size()));
+    }
+    if (!_personalArchiveStorageOk) personalArchiveWarning();
+}
+
+bool ApiWrap::savePersonalArchive() {
+    if (!_personalArchiveStorageOk) { personalArchiveWarning(); return false; }
+    const auto data = _personalArchiveRules.serialize();
+    auto file = QSaveFile(personalArchivePath());
+    if (!file.open(QIODevice::WriteOnly)
+        || file.write(data.data(), qint64(data.size())) != qint64(data.size())
+        || !file.commit()) {
+        personalArchiveWarning();
+        return false;
+    }
+    return true;
+}
+
+bool ApiWrap::personalArchiveContains(PeerId peer) {
+    loadPersonalArchive();
+    return _personalArchiveRules.contains(peerToUser(peer).bare);
+}
+
+bool ApiWrap::personalArchiveSet(not_null<History*> history, bool enabled) {
+    if (!history->peer->isUser() || history->peer->isSelf()) return true;
+    loadPersonalArchive();
+    const auto before = _personalArchiveRules;
+    _personalArchiveRules.set(peerToUser(history->peer->id).bare, enabled);
+    if (!savePersonalArchive()) { _personalArchiveRules = before; return false; }
+    if (enabled) Core::App().notifications().clearFromHistory(history);
+    else _personalArchiveQueue.remove(history->peer->id);
+    return true;
+}
+
+bool ApiWrap::personalArchiveObserve(not_null<History*> history, bool archived) {
+    if (!history->peer->isUser() || history->peer->isSelf()) return false;
+    loadPersonalArchive();
+    const auto id = peerToUser(history->peer->id).bare;
+    if (archived && _personalArchiveRules.observe(id)) {
+        // Keep enforcement active this process if persistence fails; warn explicitly.
+        savePersonalArchive();
+        crl::on_main(_session, [=] { Core::App().notifications().clearFromHistory(history); });
+    }
+    const auto enforced = _personalArchiveRules.contains(id);
+    if (enforced && !archived) {
+        _personalArchiveQueue[history->peer->id] = true;
+        if (!_personalArchiveTimer.isActive()) _personalArchiveTimer.callOnce(1000);
+    }
+    return enforced;
+}
+
+void ApiWrap::syncPersonalArchive() {
+    if (_personalArchiveRetryAt > crl::now()) {
+        _personalArchiveTimer.callOnce(_personalArchiveRetryAt - crl::now());
+        return;
+    }
+    if (_personalArchiveQueue.empty()) return;
+    const auto [id, archived] = *_personalArchiveQueue.begin();
+    _personalArchiveQueue.remove(id);
+    const auto history = _session->data().historyLoaded(id);
+    // A deleted/absent dialog must not be recreated by background enforcement.
+    if (history && history->inChatList() && personalArchiveContains(id) == archived) {
+        if (_historyArchivedRequests.contains(history)) _personalArchiveQueue[id] = archived;
+        else sendHistoryArchived(history, archived, [] {});
+    }
+    if (!_personalArchiveQueue.empty()) _personalArchiveTimer.callOnce(1000);
+}
+
 void ApiWrap::toggleHistoryArchived(
+        not_null<History*> history,
+        bool archived,
+        Fn<void()> callback) {
+    if (!personalArchiveSet(history, archived)) return;
+    if (archived) history->setFolder(_session->data().folder(Data::Folder::kId));
+    else history->clearFolder();
+    sendHistoryArchived(history, archived, std::move(callback));
+}
