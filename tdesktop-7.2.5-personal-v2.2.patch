+void ProxyRotationManager::personalTick() {
+	auto ready = false;
+	auto connected = false;
+	for (const auto &entry : App().domain().accounts()) {
+		const auto account = entry.account.get();
+		if (!account->mtpStarted() || account->mtp().isTestMode()) {
+			continue;
+		}
+		// Includes the unauthenticated login screen, not just sessions.
+		ready = true;
+		connected = connected || account->mtp().dcstate() == MTP::ConnectedState;
+	}
+	const auto state = _personalPolicy.update(
+		crl::now(), ready, connected, App().settings().proxy().personalFallback());
+	if (_personalPolicy.fallback()) {
+		App().fallbackPersonalProxy();
+	}
+	const auto text = [&] {
+		using State = PersonalProxyPolicy::State;
+		switch (state) {
+		case State::Waiting: return "waiting_for_account";
+		case State::Trying: return "trying_mtproto";
+		case State::ProxyConnected: return "mtproto_connected";
+		case State::Direct: return "fallback_direct";
+		case State::DirectConnected: return "direct_connected";
+		}
+		Unexpected("Personal proxy state");
+	}();
+	const auto data = QByteArray("status=") + text
+		+ "\npid=" + QByteArray::number(QCoreApplication::applicationPid())
+		+ "\nmtproto_ever_connected=" + (_personalPolicy.everConnected() ? "1" : "0")
+		+ "\nfallback_latched=" + (_personalPolicy.fallback() ? "1" : "0")
+		+ "\n";
+	if (data != _personalLastState) {
+		auto file = QSaveFile(QCoreApplication::applicationDirPath()
+			+ u"/tdata/personal_proxy_state.txt"_q);
+		if (file.open(QIODevice::WriteOnly)
+			&& file.write(data) == data.size()
+			&& file.commit()) {
+			_personalLastState = data;
+		}
+	}
+	_personalTimer.callOnce(1000);
+}
